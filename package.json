{
  "name": "bili-music",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bilibili 听视频 + 网易云一起听 的跨平台音乐客户端",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
