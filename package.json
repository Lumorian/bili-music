    "tauri:build": "tauri build",
    "tauri:build:android": "tauri android build",
    "sync:dev": "cargo run --manifest-path server/Cargo.toml",
    "sync:build": "cargo build --release --manifest-path server/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
